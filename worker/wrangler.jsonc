{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "moodboard-public-images",
	"main": "src/index.js",
	"compatibility_date": "2026-11-01",
	"workers_dev": true,
	"routes": [{ "pattern": "moodboard-api.haroldpoi.dev/api/mb/public/*", "zone_name": "haroldpoi.dev" }],
	"vars": { "ORIGIN": "https://moodboard-api.haroldpoi.dev" },
	"observability": { "enabled": true }
}
