{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "moodboard-private-images",
	"main": "src/images.js",
	"compatibility_date": "2026-11-01",
	"workers_dev": false,
	"routes": [{ "pattern": "images.haroldpoi.dev/mbinspirations/*", "zone_name": "haroldpoi.dev" }],
	"observability": { "enabled": true }
}
